<?xml version="1.0"?>
<package format="3">
  <name>obj_to_pointcloud</name>
  <version>0.18.3</version>
  <description>OBJ file to pointcloud message converter package</description>

  <maintainer email="atsushi.w@ieee.org">Atsushi Watanabe</maintainer>
  <license>BSD</license>
  <author email="atsushi.w@ieee.org">Atsushi Watanabe</author>

  <buildtool_depend condition="$ROS_VERSION == 1">catkin</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake_auto</buildtool_depend>

  <!-- ROS 1 interface layer (roscpp node). -->
  <depend condition="$ROS_VERSION == 1">roscpp</depend>
  <!-- Provides the rclcpp-style shim used by the hybrid logic on ROS 1. -->
  <depend condition="$ROS_VERSION == 1">sq_ros1_rclcpp_compat</depend>

  <!-- ROS 2 interface layer uses the real rclcpp and component registration. -->
  <depend condition="$ROS_VERSION == 2">rclcpp</depend>
  <depend condition="$ROS_VERSION == 2">rclcpp_components</depend>

  <depend>geometry_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>sensor_msgs</depend>

  <depend>neonavigation_common</depend>

  <depend>eigen</depend>

  <build_depend>libpcl-all-dev</build_depend>
  <exec_depend>libpcl-all</exec_depend>

  <test_depend condition="$ROS_VERSION == 1">rostest</test_depend>

  <test_depend condition="$ROS_VERSION == 2">ament_lint_auto</test_depend>
  <test_depend condition="$ROS_VERSION == 2">ament_lint_common</test_depend>
  <test_depend condition="$ROS_VERSION == 2">ament_cmake_clang_format</test_depend>
  <test_depend condition="$ROS_VERSION == 2">ament_cmake_gtest</test_depend>
  <test_depend condition="$ROS_VERSION == 2">launch_testing</test_depend>
  <test_depend condition="$ROS_VERSION == 2">launch_testing_ament_cmake</test_depend>
  <test_depend condition="$ROS_VERSION == 2">launch_testing_ros</test_depend>
  <test_depend condition="$ROS_VERSION == 2">ament_index_python</test_depend>
  <test_depend condition="$ROS_VERSION == 2">launch</test_depend>
  <test_depend condition="$ROS_VERSION == 2">launch_ros</test_depend>

  <export>
    <build_type condition="$ROS_VERSION == 1">catkin</build_type>
    <build_type condition="$ROS_VERSION == 2">ament_cmake</build_type>
  </export>
</package>
